# Database
PDF_PARSING_DATABASE_URL=sqlite:///pdf_parsing.db
# PDF_PARSING_DATABASE_URL=postgresql://user:password@localhost:5432/pdf_parsing

# OCR
PDF_PARSING_DEFAULT_OCR_BACKEND=docling_default

# LLM
PDF_PARSING_DEFAULT_LLM_PROVIDER=openai
PDF_PARSING_DEFAULT_LLM_MODEL=gpt-4o
PDF_PARSING_OPENAI_API_KEY=sk-...
PDF_PARSING_ANTHROPIC_API_KEY=sk-ant-...

# Parsing
PDF_PARSING_DEFAULT_CONFIDENCE_THRESHOLD=0.85
PDF_PARSING_MAX_RETRIES=3

# Dash
PDF_PARSING_DASH_HOST=0.0.0.0
PDF_PARSING_DASH_PORT=8050
PDF_PARSING_DASH_DEBUG=true

# Prefect
PDF_PARSING_PREFECT_API_URL=http://localhost:4200/api
